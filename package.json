{
  "name": "branded-photo-frame-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digital Engagement & Social Sharing Branded Photo Frame Tool",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "mongoose": "^9.10.4",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
